# Cadena de conexión a Postgres de Supabase.
#
# CÓPIALA ENTERA desde el dashboard: botón "Connect" → Transaction pooler.
# No la construyas a mano: el prefijo numérico del host (aws-0-, aws-1-, ...) depende del
# proyecto y no se puede adivinar a partir de la región.
#
# Se usa el pooler (puerto 6543) y no la conexión directa porque cada función serverless
# abre su propio pool y la conexión directa se agota enseguida.
#
# DEJA EL MARCADOR [YOUR-PASSWORD] TAL CUAL y pon la contraseña abajo, en
# DATABASE_PASSWORD. Meterla dentro de la URL obliga a percent-encoding y falla de dos
# maneras, una de ellas silenciosa:
#   - "Ab%cd-12" se decodifica a "Abd-12" sin dar ningún error.
#   - una contraseña con @, :, / o # invalida la URL entera.
DATABASE_URL=postgresql://postgres.TU_REF_DE_PROYECTO:[YOUR-PASSWORD]@aws-N-TU_REGION.pooler.supabase.com:6543/postgres

# Contraseña de la base de datos, en crudo y sin codificar nada.
# Supabase → Settings → Database. Si no la recuerdas, "Reset database password".
DATABASE_PASSWORD=tu_password_tal_cual

# URL del proyecto de Supabase. Se usa para subir y servir las portadas.
SUPABASE_URL=https://bcdeomzwzbbromorjnmw.supabase.co

# Clave secreta del servidor: Supabase → Settings → API Keys.
# Vale tanto una secret key nueva (sb_secret_...) como la service_role heredada (eyJ...).
# Omite RLS por completo: solo se usa en el servidor, nunca se envía al navegador
# y nunca debe subirse al repositorio.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxx

# Opcional. Con "false" no se insertan los libros de ejemplo en una tabla vacía.
# Ponlo en false antes de importar tus datos reales.
SEED_BOOKS=true
